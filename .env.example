# Example values only. `make setup` creates a local .env (git-ignored) with random passwords.
# Never commit a real .env file.

# PostgreSQL superuser of the local container (used only to create roles and databases).
POSTGRES_ADMIN_USER=dr_admin
POSTGRES_ADMIN_PASSWORD=change-me

# Host/port where the pipeline and dashboard reach PostgreSQL (published on localhost only).
DR_DB_HOST=127.0.0.1
DR_DB_PORT=55432

# Role that owns and writes the analytical schemas.
DR_PIPELINE_USER=dr_pipeline
DR_PIPELINE_PASSWORD=change-me

# Read-only role used by the dashboard.
DR_READER_USER=dr_reader
DR_READER_PASSWORD=change-me
