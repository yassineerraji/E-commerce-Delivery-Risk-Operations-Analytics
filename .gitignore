# Environment and secrets
.env
.env.*
!.env.example
kaggle.json

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Data: raw and generated datasets are never versioned
data/raw/*
!data/raw/.gitkeep

# Local project brief (never published)
CLAUDE.md

# Generated artifacts (models, scores). Reports are versioned selectively.
artifacts/*/*
!artifacts/*/.gitkeep
artifacts/e2e/
artifacts/test/
reports/**/*.parquet

# OS / editors
.DS_Store
.idea/
.vscode/

# Outputs of the test databases (regenerated by pytest)
reports/*/test/
reports/*/e2e/

# Example report from another project (local reference only)
/report.pdf

# Local database exports for deployment
*.dump
*.dump.partial
